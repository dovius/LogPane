{
  "name": "logpane",
  "version": "1.0.0",
  "private": true,
  "description": "LogPane – a fast, private JSON and NDJSON log viewer (Chrome extension).",
  "license": "MIT",
  "homepage": "https://github.com/dovius/LogPane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dovius/LogPane.git"
  },
  "bugs": {
    "url": "https://github.com/dovius/LogPane/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "zip": "node build.mjs --zip",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:all": "npm run typecheck && npm test && npm run test:e2e",
    "dev-server": "node scripts/dev-server.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
